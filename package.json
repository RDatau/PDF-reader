{
  "name": "voxreader",
  "productName": "VOXReader",
  "version": "1.0.0",
  "description": "VOXReader: Aplikasi pembaca PDF Windows modern berbasis Electron dengan Gemini AI, TTS suara alami, mode malam, dan analisis dokumen offline.",
  "author": "VOXReader Team",
  "main": "dist-electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/generate-icons.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run electron:compile",
    "electron:compile": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/preload.cjs",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron:dev": "npm run electron:compile && node scripts/electron-dev.mjs",
    "build:win": "npm run electron:build",
    "portable:win": "npm run build && electron-builder --win portable",
    "pack:win": "npm run build && electron-builder --win --dir",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js release",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.voxreader.app",
    "productName": "VOXReader",
    "copyright": "Copyright © 2026 VOXReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "Dokumen PDF (Buka dengan VOXReader)",
        "icon": "build/icon.ico",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/installer.ico",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VOXReader",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsdom": "^30.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
